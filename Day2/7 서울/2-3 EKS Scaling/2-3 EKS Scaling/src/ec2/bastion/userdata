#!/bin/bash
set -euo pipefail

REGION_CODE="ap-northeast-2"
CLUSTER_NAME="skm-eks-cluster"
K8S_VERSION="1.35"
KARPENTER_VERSION="1.9.1"
NAMESPACE="skillsmkt"
ECR_REPO="skm-ecr"
SQS_QUEUE_NAME="skm-order-queue"
ADDON_NODEGROUP_NAME="skm-cluster-addon-ng"
K9S_VERSION="v0.51.0"
ROOT_PASSWORD="Skill53##"
EC2USER_PASSWORD="Skill53##"

dnf update -y
dnf install --allowerasing -y jq curl wget unzip vim dos2unix docker

systemctl start docker
systemctl enable docker

curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip -q awscliv2.zip
./aws/install
rm -rf awscliv2.zip aws/

dnf install -y https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm

sed -i 's|PasswordAuthentication no|PasswordAuthentication yes|g' /etc/ssh/sshd_config
systemctl restart sshd

if [[ -n "${ROOT_PASSWORD}" ]]; then
  echo "${ROOT_PASSWORD}" | passwd --stdin root
fi
if [[ -n "${EC2USER_PASSWORD}" ]]; then
  echo "${EC2USER_PASSWORD}" | passwd --stdin ec2-user
fi

# ===== eksctl (retry) =====
for i in 1 2 3 4 5; do
  if curl --silent --location --fail --retry 3 --retry-delay 5 \
    "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_$(uname -s)_amd64.tar.gz" \
    -o /tmp/eksctl.tar.gz; then
    tar xz -C /tmp -f /tmp/eksctl.tar.gz
    mv /tmp/eksctl /usr/local/bin
    rm -f /tmp/eksctl.tar.gz
    break
  fi
  echo "eksctl download retry $i ..."
  sleep 15
done

# ===== kubectl =====
curl -O "https://s3.us-west-2.amazonaws.com/amazon-eks/1.35.6/2026-07-05/bin/linux/amd64/kubectl"
chmod +x kubectl
mv kubectl /usr/local/bin

# ===== helm (retry) =====
for i in 1 2 3; do
  if curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3; then
    chmod 700 get_helm.sh
    ./get_helm.sh
    rm -f get_helm.sh
    break
  fi
  echo "helm download retry $i ..."
  sleep 10
done

# ===== k9s (retry) =====
mkdir -p /tmp/k9s
cd /tmp/k9s
for i in 1 2 3 4 5; do
  if curl -LO --fail --retry 3 --retry-delay 5 \
    "https://github.com/derailed/k9s/releases/download/${K9S_VERSION}/k9s_Linux_amd64.tar.gz"; then
    tar -xf k9s_Linux_amd64.tar.gz
    chmod +x k9s
    mv k9s /usr/local/bin
    break
  fi
  echo "k9s download retry $i ..."
  sleep 15
done
cd /
rm -rf /tmp/k9s

chown -R ec2-user:ec2-user /home/ec2-user/
mkdir -p /home/ec2-user/eks/manifest
mkdir -p /home/ec2-user/src/app

cat << EOF > /home/ec2-user/eks/cluster.yaml
apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig
metadata:
  name: ${CLUSTER_NAME}
  region: ${REGION_CODE}
  version: "${K8S_VERSION}"
  tags:
    karpenter.sh/discovery: ${CLUSTER_NAME}
cloudWatch:
  clusterLogging:
    enableTypes: ["*"]
iam:
  withOIDC: true
karpenter:
  version: '${KARPENTER_VERSION}'
  createServiceAccount: true
vpc:
  id: VPC_ID_PLACEHOLDER
  subnets:
    private:
      ${REGION_CODE}a:
        id: PRIVATE_A
      ${REGION_CODE}c:
        id: PRIVATE_C
managedNodeGroups:
  - name: ${ADDON_NODEGROUP_NAME}
    labels:
      skm-cluster-addon-ng-node: "true"
      type: addon
    instanceName: ${ADDON_NODEGROUP_NAME}-node
    instanceType: t3.medium
    desiredCapacity: 1
    minSize: 1
    maxSize: 1
    privateNetworking: true
    amiFamily: AmazonLinux2023
EOF

cat << 'EOF' > /home/ec2-user/src/app/requirements.txt
boto3>=1.35.0
flask>=3.0.0
EOF

cat << 'EOF' > /home/ec2-user/src/app/Dockerfile
FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py .
EXPOSE 8080
ENV PYTHONUNBUFFERED=1
CMD ["python", "app.py"]
EOF

cat << 'EOF' > /home/ec2-user/src/app/app.py
import os
import threading
import time
import boto3
from flask import Flask, jsonify

app = Flask(__name__)

AWS_REGION = os.environ.get("AWS_REGION", "ap-northeast-2")
SQS_QUEUE_URL = os.environ.get("SQS_QUEUE_URL", "")
PROCESSING_TIME = float(os.environ.get("PROCESSING_TIME", "3"))

sqs = boto3.client("sqs", region_name=AWS_REGION)
_processed = 0
_lock = threading.Lock()
_stop = threading.Event()

def _consumer_loop() -> None:
    global _processed
    while not _stop.is_set():
        if not SQS_QUEUE_URL:
            time.sleep(1)
            continue
        try:
            response = sqs.receive_message(
                QueueUrl=SQS_QUEUE_URL,
                MaxNumberOfMessages=10,
                WaitTimeSeconds=20,
            )
        except Exception:
            time.sleep(1)
            continue
        for message in response.get("Messages", []):
            message_id = message["MessageId"]
            body = message.get("Body", "")
            time.sleep(PROCESSING_TIME)
            try:
                sqs.delete_message(
                    QueueUrl=SQS_QUEUE_URL,
                    ReceiptHandle=message["ReceiptHandle"],
                )
                with _lock:
                    _processed += 1
                print(
                    f"processed message_id={message_id} body={body}",
                    flush=True,
                )
            except Exception as exc:
                print(
                    f"failed message_id={message_id} error={exc}",
                    flush=True,
                )

@app.route("/healthz", methods=["GET"])
def healthz():
    return jsonify({"status": "ok"}), 200

@app.route("/status", methods=["GET"])
def status():
    with _lock:
        count = _processed
    return jsonify(
        {
            "processed": count,
            "queue_url": SQS_QUEUE_URL,
        }
    ), 200

if __name__ == "__main__":
    threading.Thread(
        target=_consumer_loop,
        daemon=True,
    ).start()
    app.run(
        host="0.0.0.0",
        port=8080,
    )
EOF

cat << EOF > /home/ec2-user/eks/manifest/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-processor
  namespace: ${NAMESPACE}
  labels:
    app: order-processor
spec:
  replicas: 1
  selector:
    matchLabels:
      app: order-processor
  template:
    metadata:
      labels:
        app: order-processor
    spec:
      serviceAccountName: order-processor-sa
      containers:
      - name: order-processor-cnt
        image: INITIAL_IMAGE_PLACEHOLDER
        imagePullPolicy: Always
        ports:
        - containerPort: 8080
        resources:
          requests:
            cpu: "500m"
            memory: "512Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"
        env:
        - name: AWS_REGION
          value: "${REGION_CODE}"
        - name: SQS_QUEUE_URL
          value: "SQS_QUEUE_URL_PLACEHOLDER"
        - name: PROCESSING_TIME
          value: "3"
      tolerations:
        - key: workload
          operator: Equal
          value: app
          effect: NoSchedule
      nodeSelector:
        type: app
EOF

cat << 'EOF' > /home/ec2-user/eks/keda-values.yaml
serviceAccount:
  create: true
  name: keda-operator
nodeSelector:
  type: addon
tolerations:
  - key: dedicated
    operator: Equal
    value: addon
    effect: NoSchedule
metricsServer:
  nodeSelector:
    type: addon
  tolerations:
    - key: dedicated
      operator: Equal
      value: addon
      effect: NoSchedule
webhooks:
  nodeSelector:
    type: addon
  tolerations:
    - key: dedicated
      operator: Equal
      value: addon
      effect: NoSchedule
EOF

cat << EOF > /home/ec2-user/eks/manifest/karpenter.yaml
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: skm-app-nodepool
spec:
  template:
    metadata:
      labels:
        type: app
    spec:
      taints:
        - key: workload
          value: app
          effect: NoSchedule
      requirements:
        - key: node.kubernetes.io/instance-type
          operator: In
          values:
            - t3.small
            - t3.medium
        - key: karpenter.sh/capacity-type
          operator: In
          values:
            - on-demand
            - spot
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: skm-app-nodeclass
  disruption:
    consolidationPolicy: WhenEmptyOrUnderutilized
    consolidateAfter: 60s
---
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: skm-app-nodeclass
spec:
  amiFamily: AL2023
  amiSelectorTerms:
    - alias: al2023@latest
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: "${CLUSTER_NAME}"
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: "${CLUSTER_NAME}"
  role: "KARPENTER_ROLE_NAME"
EOF

cat << EOF > /home/ec2-user/eks/manifest/scaledobject.yaml
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: order-scaler
  namespace: ${NAMESPACE}
spec:
  scaleTargetRef:
    name: order-processor
  minReplicaCount: 1
  maxReplicaCount: 5
  pollingInterval: 15
  cooldownPeriod: 30
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleDown:
          stabilizationWindowSeconds: 30
          policies:
            - type: Percent
              value: 100
              periodSeconds: 15
  triggers:
  - type: aws-sqs-queue
    metadata:
      queueURL: SQS_QUEUE_URL
      activationQueueLength: "0"
      queueLength: "5"
      awsRegion: ${REGION_CODE}
      identityOwner: operator
EOF

chown -R ec2-user:ec2-user /home/ec2-user/eks
chown -R ec2-user:ec2-user /home/ec2-user/src

(
  set -euo pipefail

  TOKEN=$(curl -s -X PUT \
    "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
  INST_ID=$(curl -s \
    -H "X-aws-ec2-metadata-token: $TOKEN" \
    http://169.254.169.254/latest/meta-data/instance-id)

  VPC_ID=$(aws ec2 describe-instances \
    --instance-ids "$INST_ID" \
    --region "$REGION_CODE" \
    --query "Reservations[0].Instances[0].VpcId" \
    --output text)

  PRIVATE_A_ID=$(aws ec2 describe-subnets \
    --region "$REGION_CODE" \
    --filters \
      "Name=vpc-id,Values=$VPC_ID" \
      "Name=availability-zone,Values=${REGION_CODE}a" \
    --query "Subnets[?MapPublicIpOnLaunch==\`false\`].SubnetId" \
    --output text \
    | awk '{print $1}')

  PRIVATE_C_ID=$(aws ec2 describe-subnets \
    --region "$REGION_CODE" \
    --filters \
      "Name=vpc-id,Values=$VPC_ID" \
      "Name=availability-zone,Values=${REGION_CODE}c" \
    --query "Subnets[?MapPublicIpOnLaunch==\`false\`].SubnetId" \
    --output text \
    | awk '{print $1}')

  sed -i "s|VPC_ID_PLACEHOLDER|$VPC_ID|g" /home/ec2-user/eks/cluster.yaml
  sed -i "s|PRIVATE_A|$PRIVATE_A_ID|g" /home/ec2-user/eks/cluster.yaml
  sed -i "s|PRIVATE_C|$PRIVATE_C_ID|g" /home/ec2-user/eks/cluster.yaml

  if [ -d "/home/ec2-user/scripts" ]; then
    chmod +x /home/ec2-user/scripts/*
    dos2unix /home/ec2-user/scripts/* || true
  fi

  eksctl create cluster -f /home/ec2-user/eks/cluster.yaml

  aws eks update-kubeconfig \
    --region "$REGION_CODE" \
    --name "$CLUSTER_NAME"

  export KUBECONFIG=/root/.kube/config
  mkdir -p /home/ec2-user/.kube
  cp /root/.kube/config /home/ec2-user/.kube/config
  chown -R ec2-user:ec2-user /home/ec2-user/.kube

  AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

  aws ecr create-repository \
    --repository-name "$ECR_REPO" \
    --region "$REGION_CODE" || true

  aws ecr get-login-password --region "$REGION_CODE" \
    | docker login --username AWS --password-stdin \
      "$AWS_ACCOUNT_ID.dkr.ecr.$REGION_CODE.amazonaws.com"

  cd /home/ec2-user/src/app
  docker build -t "$ECR_REPO" .
  docker tag "$ECR_REPO:latest" \
    "$AWS_ACCOUNT_ID.dkr.ecr.$REGION_CODE.amazonaws.com/$ECR_REPO:latest"
  docker push \
    "$AWS_ACCOUNT_ID.dkr.ecr.$REGION_CODE.amazonaws.com/$ECR_REPO:latest"

  aws ec2 create-tags \
    --resources "$PRIVATE_A_ID" "$PRIVATE_C_ID" \
    --tags Key=karpenter.sh/discovery,Value="$CLUSTER_NAME" \
    --region "$REGION_CODE"

  aws sqs create-queue \
    --queue-name "$SQS_QUEUE_NAME" \
    --region "$REGION_CODE" || true

  NODE_ROLE_NAME=$(aws iam list-roles \
    --query "Roles[?starts_with(RoleName, 'eksctl-${CLUSTER_NAME}-nodegroup')].RoleName" \
    --output text | awk '{print $1}')

  if [ -n "$NODE_ROLE_NAME" ]; then
    aws iam attach-role-policy \
      --role-name "$NODE_ROLE_NAME" \
      --policy-arn arn:aws:iam::aws:policy/AmazonSQSFullAccess || true
  fi

  kubectl create namespace "$NAMESPACE" || true
  kubectl create serviceaccount order-processor-sa \
    -n "$NAMESPACE" \
    --dry-run=client -o yaml | kubectl apply -f -

  helm repo add kedacore https://kedacore.github.io/charts || true
  helm repo update
  helm upgrade --install keda \
    kedacore/keda \
    --namespace keda \
    --create-namespace \
    -f /home/ec2-user/eks/keda-values.yaml

  cd /home/ec2-user/eks/manifest

  REAL_SQS_URL=$(aws sqs get-queue-url \
    --queue-name "$SQS_QUEUE_NAME" \
    --region "$REGION_CODE" \
    --query "QueueUrl" \
    --output text)

  KARPENTER_ROLE_NAME=$(aws iam list-roles \
    --query "Roles[?contains(RoleName, 'KarpenterNodeRole') && contains(RoleName, '${CLUSTER_NAME}')].RoleName" \
    --output text | awk '{print $1}')

  if [ -z "$KARPENTER_ROLE_NAME" ]; then
    KARPENTER_ROLE_NAME="eksctl-KarpenterNodeRole-${CLUSTER_NAME}"
  fi

  sed -i \
    "s|INITIAL_IMAGE_PLACEHOLDER|$AWS_ACCOUNT_ID.dkr.ecr.$REGION_CODE.amazonaws.com/$ECR_REPO:latest|g" \
    deployment.yaml
  sed -i \
    "s|SQS_QUEUE_URL_PLACEHOLDER|$REAL_SQS_URL|g" \
    deployment.yaml
  sed -i \
    "s|queueURL: SQS_QUEUE_URL|queueURL: $REAL_SQS_URL|g" \
    scaledobject.yaml
  sed -i \
    "s|KARPENTER_ROLE_NAME|$KARPENTER_ROLE_NAME|g" \
    karpenter.yaml

  kubectl apply -f karpenter.yaml
  kubectl apply -f deployment.yaml
  kubectl apply -f scaledobject.yaml

  # ===== Karpenter IRSA (안정 버전) =====
  kubectl get sa karpenter -n kube-system >/dev/null 2>&1 || \
    kubectl create serviceaccount karpenter -n kube-system

  IAM_SERVICE_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/eksctl-${CLUSTER_NAME}-iamservice-role"

  kubectl annotate serviceaccount karpenter \
    -n kube-system \
    eks.amazonaws.com/role-arn="${IAM_SERVICE_ROLE_ARN}" \
    --overwrite || true

  OIDC_ID=$(aws eks describe-cluster \
    --name "$CLUSTER_NAME" \
    --region "$REGION_CODE" \
    --query 'cluster.identity.oidc.issuer' \
    --output text | awk -F/ '{print $NF}')

  ROLE_NAME="eksctl-${CLUSTER_NAME}-iamservice-role"

  cat > /tmp/karpenter-trust.json << EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::$${AWS_ACCOUNT_ID}:oidc-provider/oidc.eks.$${REGION_CODE}.amazonaws.com/id/$${OIDC_ID}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.eks.$${REGION_CODE}.amazonaws.com/id/$${OIDC_ID}:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "oidc.eks.$${REGION_CODE}.amazonaws.com/id/$${OIDC_ID}:sub": [
            "system:serviceaccount:kube-system:karpenter",
            "system:serviceaccount:karpenter:karpenter"
          ]
        }
      }
    }
  ]
}
EOF

  aws iam update-assume-role-policy \
    --role-name "$ROLE_NAME" \
    --policy-document file:///tmp/karpenter-trust.json || true

  kubectl get clusterrolebinding karpenter-kube-system >/dev/null 2>&1 || \
    kubectl create clusterrolebinding karpenter-kube-system \
      --clusterrole=karpenter \
      --serviceaccount=kube-system:karpenter || true

  kubectl get clusterrolebinding karpenter-core-kube-system >/dev/null 2>&1 || \
    kubectl create clusterrolebinding karpenter-core-kube-system \
      --clusterrole=karpenter-core \
      --serviceaccount=kube-system:karpenter || true

  kubectl patch rolebinding karpenter-dns \
    -n kube-system \
    --type='json' \
    -p='[{"op":"replace","path":"/subjects/0/namespace","value":"kube-system"}]' \
    2>/dev/null || true

  if kubectl get deployment karpenter -n karpenter >/dev/null 2>&1; then
    kubectl get deployment karpenter -n karpenter -o json \
      | jq '
        del(
          .metadata.uid,
          .metadata.resourceVersion,
          .metadata.generation,
          .metadata.creationTimestamp,
          .metadata.managedFields,
          .metadata.annotations["meta.helm.sh/release-name"],
          .metadata.annotations["meta.helm.sh/release-namespace"]
        )
        |
        .metadata.namespace = "kube-system"
        |
        .spec.replicas = 1
      ' \
      | kubectl apply -f - || true

    kubectl get svc karpenter -n kube-system >/dev/null 2>&1 || \
      kubectl expose deployment karpenter \
        -n kube-system \
        --name=karpenter \
        --port=8080 \
        --target-port=8080 || true
  fi

  kubectl rollout restart deployment/karpenter -n kube-system || true
  kubectl rollout status deployment/karpenter -n kube-system --timeout=180s || true

  echo "=== Karpenter Pods ==="
  kubectl get pod -n kube-system -l app.kubernetes.io/name=karpenter -o name || true

  echo "=== NodePool 정보 ==="
  kubectl get nodepool skm-app-nodepool \
    -o jsonpath='{.spec.disruption.consolidationPolicy} {.spec.disruption.consolidateAfter}{"\n"}' || true

  kubectl get nodepool skm-app-nodepool -o json \
    | jq -r '
      .spec.template.spec.requirements[]
      | select(.key == "node.kubernetes.io/instance-type")
      | .values
      | sort
      | join(",")
    ' || true

  kubectl get nodepool skm-app-nodepool -o json \
    | jq '.spec.template.spec.taints | length' || true

  kubectl get ec2nodeclass skm-app-nodeclass -o name || true

  sleep 20

  if [ -d "/home/ec2-user/scripts" ]; then
    /home/ec2-user/scripts/kube-setup.sh || true
  fi

  echo "=== Setup completed successfully ==="
) > /var/log/eksctl-build.log 2>&1 &

echo "로그 확인: tail -f /var/log/eksctl-build.log"