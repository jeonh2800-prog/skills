#!/bin/bash
exec > /var/log/app-bootstrap.log 2>&1
set -x

# 1) 런타임 설치
dnf update -y
dnf install -y python3 python3-pip

# 2) 애플리케이션 파일 배치 (Terraform이 base64로 주입)
mkdir -p /opt/app
echo "${app_py_b64}" | base64 -d > /opt/app/app.py
echo "${requirements_b64}" | base64 -d > /opt/app/requirements.txt

# 3) 가상환경 + 의존성 설치
python3 -m venv /opt/app/venv
/opt/app/venv/bin/pip install --upgrade pip
/opt/app/venv/bin/pip install -r /opt/app/requirements.txt

# 4) 환경 변수
cat > /etc/app.env <<ENVFILE
AWS_REGION=${aws_region}
TABLE_NAME=${table_name}
GSI_NAME=${gsi_name}
ENVFILE

# 5) systemd 서비스 등록 (TCP 8080)
cat > /etc/systemd/system/app.service <<'UNIT'
[Unit]
Description=BigBae NoSQL Flask App
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/app.env
ExecStart=/opt/app/venv/bin/python /opt/app/app.py
WorkingDirectory=/opt/app
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable app.service
systemctl start app.service
