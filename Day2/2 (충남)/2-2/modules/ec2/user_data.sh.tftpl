#!/bin/bash
set -eux

dnf update -y
dnf install -y python3.12 python3.12-pip || dnf install -y python3 python3-pip

# 사용할 python 인터프리터 결정 (3.12 우선, 없으면 시스템 python3)
PYBIN="$(command -v python3.12 || command -v python3)"

mkdir -p /opt/app
echo "${app_py_b64}" | base64 -d > /opt/app/app.py
echo "${reqs_b64}" | base64 -d > /opt/app/requirements.txt

"$PYBIN" -m venv /opt/app/venv
/opt/app/venv/bin/pip install --upgrade pip
/opt/app/venv/bin/pip install -r /opt/app/requirements.txt

cat > /opt/app/app.env <<EOF
STREAM_NAME=${stream_name}
AWS_REGION=${aws_region}
EOF

cat > /etc/systemd/system/app.service <<EOF
[Unit]
Description=Order log generator (Flask + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/app
EnvironmentFile=/opt/app/app.env
ExecStart=/opt/app/venv/bin/gunicorn --bind 0.0.0.0:${app_port} --workers 2 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now app.service

# SSM Agent 활성화 보장
systemctl enable --now amazon-ssm-agent || true
